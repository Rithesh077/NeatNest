<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/windowBackground"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- RAM Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/devmode_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RAM Usage"
                    android:textSize="13sp"
                    android:textColor="@color/devmode_dark"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvRamUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- / -- MB"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/devmode_dark"
                    android:layout_marginTop="4dp" />

                <ProgressBar
                    android:id="@+id/pbRam"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progressTint="@color/devmode_tint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Storage Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/devmode_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Storage"
                    android:textSize="13sp"
                    android:textColor="@color/devmode_dark"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvStorageUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="-- / -- GB"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/devmode_dark"
                    android:layout_marginTop="4dp" />

                <ProgressBar
                    android:id="@+id/pbStorage"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progressTint="@color/devmode_tint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Battery Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/devmode_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Battery"
                    android:textSize="13sp"
                    android:textColor="@color/devmode_dark"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvBattery"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--%"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/devmode_dark"
                    android:layout_marginTop="4dp" />

                <TextView
                    android:id="@+id/tvBatteryDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--°C • Not charging"
                    android:textSize="12sp"
                    android:textColor="@color/text_secondary"
                    android:layout_marginTop="2dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- CPU Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/devmode_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="CPU Usage"
                    android:textSize="13sp"
                    android:textColor="@color/devmode_dark"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvCpuUsage"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--% "
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="@color/devmode_dark"
                    android:layout_marginTop="4dp" />

                <ProgressBar
                    android:id="@+id/pbCpu"
                    style="@android:style/Widget.ProgressBar.Horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="8dp"
                    android:layout_marginTop="8dp"
                    android:max="100"
                    android:progressTint="@color/devmode_tint" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Device Info Card -->
        <com.google.android.material.card.MaterialCardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:cardCornerRadius="16dp"
            app:cardElevation="0dp"
            app:cardBackgroundColor="@color/devmode_light">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device Info"
                    android:textSize="13sp"
                    android:textColor="@color/devmode_dark"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvDeviceInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Loading..."
                    android:textSize="13sp"
                    android:textColor="@color/text_secondary"
                    android:lineSpacingExtra="4dp"
                    android:layout_marginTop="8dp" />
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>

    </LinearLayout>
</ScrollView>
